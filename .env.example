# --- Firebase client config (safe to expose in the browser bundle) ---
# Firebase console → Project settings → General → Your apps → SDK setup and config
# Example shapes shown below (these exact values are fake — copy your own from Firebase):
# VITE_FIREBASE_API_KEY=AIzaSyD-example1234567890abcdefghijk
# VITE_FIREBASE_AUTH_DOMAIN=my-portfolio-a1b2c.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=my-portfolio-a1b2c
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcd1234ef567890gh1234
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-only secrets (used by /api/admin-login.js, never exposed to the client) ---

# The password required to access the hidden /admin route. Pick something long and random.
# Example: ADMIN_PASSWORD=correct-horse-battery-staple-9f2a
ADMIN_PASSWORD=

# Firebase Admin SDK service account (Firebase console → Project settings →
# Service accounts → Generate new private key). Copy the three fields below
# from the downloaded JSON file.
# Example:
# FIREBASE_ADMIN_PROJECT_ID=my-portfolio-a1b2c
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-abc12@my-portfolio-a1b2c.iam.gserviceaccount.com
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escape sequences from the JSON file's private_key field as-is, and keep the quotes.
# Example: FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (used by /api/upload-signature.js for resume + image uploads) ---
# Sign up free at cloudinary.com — no card required. Dashboard home page shows
# all three of these values directly.
# Example:
# CLOUDINARY_CLOUD_NAME=dxyz1234
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=AbCdEfGhIjKlMnOpQrStUvWxYz1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Contact form (used by /api/contact.js) ---
# Sign up at resend.com (free tier), create an API key.
# Example: RESEND_API_KEY=re_ExampLe_1234567890abcdefghijklmno
RESEND_API_KEY=
# Optional fallback only. The contact form normally sends to whatever email
# is set in the admin dashboard's Site Info tab — this is only used if that
# field is somehow empty when a message comes in.
# Example: CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_TO_EMAIL=
# Optional. Without a verified domain on Resend, leave this as the default —
# Resend's shared onboarding@resend.dev sender works without setup but Resend
# may restrict delivery until you verify your own sending domain. See README.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# --- SEO (used to build absolute URLs for the sitemap and social previews) ---
# Your deployed site's URL, no trailing slash.
# Example: SITE_URL=https://ahmadnaeem.dev
SITE_URL=
